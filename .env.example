# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé « publishable » (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « secret » (sb_secret_…), uniquement côté serveur (jamais dans le navigateur)
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=https://billetterie.lsvb.fr

# SumUp (developer.sumup.com) : clé API secrète et code marchand
# Laissés vides : paiement simulé, réservé à l'équipe connectée (pour tester)
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Envoi des billets par e-mail (facultatif mais conseillé) : boîte d'envoi SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LSVB Billetterie <billetterie@exemple.fr>"

# Notifications des applications : mettre 1 une fois Firebase et la clé Apple configurés
NEXT_PUBLIC_PUSH_READY=
